[
    {
        "id": "inject-demo",
        "type": "inject",
        "z": "flow-demo",
        "name": "Inject Demo",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "demo",
        "payload": "",
