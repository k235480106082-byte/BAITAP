        "x": 160,
        "y": 160,
        "wires": [
            [
                "function-demo"
            ]
        ]
    },
    {
        "id": "function-demo",
        "type": "function",
        "z": "flow-demo",
        "name": "Create Demo Message",
        "func": "const now = new Date();\nmsg.payload = {\n    ok: 1,\n    msg: \"Node-RED hoạt động\",\n    time: now.toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 160,
        "wires": [
            [
                "debug-demo"
            ]
        ]
    },
    {
        "id": "debug-demo",
        "type": "debug",
        "z": "flow-demo",
        "name": "Debug Output",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 600,
        "y": 160,
        "wires": []
    },
    {
        "id": "http-in-students",
        "type": "http in",
        "z": "flow-api",
        "name": "GET /api/students",
